# Claude Agent Starter — environment variable configuration

# ── Option 1: Official Anthropic direct connection (recommended) ─────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_BASE_URL=                   # Optional, leave empty to use the default
ANTHROPIC_CUSTOM_HEADERS=             # Optional, custom request headers

# ── Option 2: AI gateway (must be compatible with the Anthropic Messages API) ─
AI_GATEWAY_API_KEY=your_gateway_key                    # Required
AI_GATEWAY_BASE_URL=https://your-gateway.example.com  # Required
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash                   # Optional
AI_GATEWAY_SMALL_MODEL=@makers/deepseek-v4-flash             # Optional

# ── Web Search Agent (optional) ──────────────────────────────────────────────
# Tencent Cloud Web Search API. Get a key at https://pages.edgeone.ai/document/sandbox-network-search-tool
WSA_API_KEY=sk-xxx                                           # Web search API key

# ── Recipe suggester (Adige) — backend model switch ──────────────────────────
# No UI toggle — this is a server-side switch only. Set to "claude" to move the
# "Ask AI" panel from the free gateway model to real Claude; leave unset/"free"
# to keep using the free model. No code change needed either way.
RECIPE_AI_PROVIDER=free                                      # "free" | "claude"
#   - free:   uses AI_GATEWAY_API_KEY / AI_GATEWAY_BASE_URL / AI_GATEWAY_MODEL above
#   - claude: uses ANTHROPIC_API_KEY above (same variable used elsewhere in this file)
# CLAUDE_RECIPE_MODEL is optional and defaults to claude-haiku-4-5 (cheap, fast).
CLAUDE_RECIPE_MODEL=claude-haiku-4-5

